# Copy this file to .env for local development.
# Never commit .env or put real credentials in this example file.

APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ollama (local development)
OLLAMA_BASE_URL=http://localhost:11434

# Docker Compose overrides OLLAMA_BASE_URL with this value so the container
# can reach an Ollama instance running on the macOS/Linux host.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

EMBEDDING_MODEL=bge-m3
LLM_MODEL=mistral:7b-instruct

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
VECTOR_STORE_PATH=data/vectors/faiss.index
