# Copy this file to .env for local development.
# Never commit .env or put real credentials in this example file.

APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ollama (local development)
OLLAMA_BASE_URL=http://localhost:11434

# Docker Compose overrides OLLAMA_BASE_URL with this value so the container
# can reach an Ollama instance running on the macOS/Linux host.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# Embedding model (must be bge-m3 for the current 1024-dimensional FAISS index)
EMBEDDING_MODEL=bge-m3

# Fast local chat model; mistral:7b-instruct is the fallback
LLM_MODEL=qwen3.5:4b
LLM_FALLBACK_MODEL=mistral:7b-instruct
# Disable reasoning-mode thinking for concise grounded answers (recommended for qwen3.5)
LLM_REASONING=false

# Retrieval / context limits
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARS=6000
MAX_ANSWER_TOKENS=512
MODEL_CONTEXT_CHARS=4096

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
VECTOR_STORE_PATH=data/vectors/demo.index
